# Optional. Raises GitHub's search rate limit from 10 to 30 requests/minute.
# Create a token with no extra scopes at https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. Used for the "Open Source" link in the navbar. Defaults to a
# placeholder if not set — point it at your own fork once you publish it.
NEXT_PUBLIC_REPO_URL=https://github.com/<  arkajitadhikary-gif>/repo-finder
